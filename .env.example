# Copy to .env and fill in — .env is gitignored, never commit real secrets.

# Safeguard POC API (Basic auth -> Bearer JWT)
SAFEGUARD_AUTH_URL=https://isov2authentication.sgpdev.com/json
SAFEGUARD_AUTH_USER=poc
SAFEGUARD_AUTH_PASSWORD=<shared by Safeguard>

SAFEGUARD_API_BASE=https://aiapi.sgpdev.com
SAFEGUARD_IMAGE_BASE=https://image.sgpdev.com

# Anthropic API key (drafter/verifier model calls)
ANTHROPIC_API_KEY=<sk-ant-...>
